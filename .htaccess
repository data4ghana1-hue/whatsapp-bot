# ── HTTP Strict Transport Security (HSTS) ──────────────────────────────────────
# Forces browsers to always use HTTPS for this domain for 1 year.
# Prevents first-connection interception and SSL-stripping attacks.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # ── Content Security Policy (CSP) ───────────────────────────────────────────
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://js.paystack.co https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://api.paystack.co https://checkout.paystack.com; frame-src 'self' https://js.paystack.co https://checkout.paystack.com; worker-src 'self' https://cdn.onesignal.com; frame-ancestors 'none';"
</IfModule>

# Disable directory listings and MultiViews (MultiViews conflicts with mod_rewrite)
Options -Indexes -MultiViews

# Increase upload size limits
LimitRequestBody 0
<IfModule mod_php7.c>
  php_value upload_max_filesize 500M
  php_value post_max_size 500M
  php_value memory_limit 1024M
  php_value max_input_vars 10000
  php_value max_execution_time 600
  php_value output_buffering 4096
</IfModule>
<IfModule mod_php.c>
  php_value upload_max_filesize 500M
  php_value post_max_size 500M
  php_value memory_limit 1024M
  php_value max_input_vars 10000
  php_value max_execution_time 600
  php_value output_buffering 4096
</IfModule>

# Enable rewriting
RewriteEngine On
RewriteBase /

# ── E-Store Direct Explicit Endpoint Rules (Highest Priority) ───────────────
RewriteRule ^verify_paystack(?:\.php)?$ E-store/verify_paystack.php [L,QSA]
RewriteRule ^webhook_paystack(?:\.php)?$ E-store/webhook_paystack.php [L,QSA]
RewriteRule ^ajax_init_store_order(?:\.php)?$ E-store/ajax_init_store_order.php [L,QSA]
RewriteRule ^ajax_verify_paystack(?:\.php)?$ E-store/ajax_verify_paystack.php [L,QSA]
RewriteRule ^ajax_check_number(?:\.php)?$ E-store/ajax_check_number.php [L,QSA]
RewriteRule ^ajax_track_order(?:\.php)?$ E-store/ajax_track_order.php [L,QSA]
RewriteRule ^shop(?:\.php)?$ E-store/shop.php [L,QSA]

# Redirect direct .php requests to extensionless URLs (SEO) - GET requests only
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{HTTP:X-Requested-With} !^XMLHttpRequest$ [NC]
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^\.]+)\.php [NC]
RewriteCond %{REQUEST_URI} !^/admin/ [NC]
RewriteCond %{REQUEST_URI} !^/webhook [NC]
RewriteCond %{REQUEST_URI} !^/api [NC]
RewriteCond %{REQUEST_URI} !^/verify_paystack [NC]
RewriteCond %{REQUEST_URI} !^/fix_server [NC]
RewriteCond %{REQUEST_URI} !^/cron_bot [NC]
RewriteCond %{REQUEST_URI} !.*/ajax_.* [NC]
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# RESTful API Routing
RewriteRule ^api/v1/([a-zA-Z0-9_-]+)/?$ /api.php?action=$1 [L,QSA]

# Sitemap (dynamic PHP generator served at canonical sitemap.xml URL)
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Explicitly rewrite subdirectories natively relative to this folder
RewriteRule ^setup/?$ store_control/setup.php [L]
RewriteRule ^setup/([a-zA-Z0-9_-]+)/?$ store_control/$1.php [L]
RewriteRule ^prices/?$ store_control/prices.php [L]
RewriteRule ^withdrawal/?$ store_control/withdrawal.php [L]
RewriteRule ^withdrwal/?$ store_control/withdrawal.php [L]
RewriteRule ^store_control/?$ store_control/setup.php [L]
RewriteRule ^store_control/([a-zA-Z0-9_-]+)/?$ store_control/$1.php [L]
RewriteRule ^store-control/?$ store_control/setup.php [L]
RewriteRule ^store-control/([a-zA-Z0-9_-]+)/?$ store_control/$1.php [L]
RewriteRule ^front/([a-zA-Z0-9_-]+)/?$ front/$1.php [L]
RewriteRule ^admin/([a-zA-Z0-9_-]+)/?$ admin/$1.php [L]
RewriteRule ^store_front/([a-zA-Z0-9_-]+)/?$ store_front/$1.php [L]

# Explicitly rewrite known root files directly
RewriteRule ^academic-writing/?$ /academic_writing.php [L]
RewriteRule ^website-designing/?$ /website_designing.php [L]
RewriteRule ^apple-subscription(?:-plan)?/?$ /apple_subscription_plan.php [L]
RewriteRule ^data-bundles/?$ /data_bundles.php [L]
RewriteRule ^verify-portal/?$ /verify_portal.php [L]
RewriteRule ^mtn-unverified/?$ /mtn_unverified.php [L]
RewriteRule ^whatsapp-bot(?:-activation)?/?$ /whatsapp_bot_activation.php [L]
RewriteRule ^alexa-covert/?$ /whatsapp_bot_activation.php [L]
RewriteRule ^(cron_bot|test|fix_server|clear_opcache|academic_writing|website_designing|apple_subscription_plan|afa_history|afa_receipt|ajax_sync_orders|ajax_virtual_cards|ajax_mtnup2gb_status|ajax_whatsapp_bot|api_docs|buy_packages|dashboard|data_bundles|db_migrate|digital_store|forgot|history|login|logout|mtn_afa|mtn_unverified|mtn_unverified_orders|mtn_verification|mtn_merchant_onboarding|mtn_merchant_sim_request|my_pins|pay_register|profile|register|register_number|send_ishare|send_mtn|send_sms|send_telecel|store|store_orders|topup|upgrade_role|verify_portal|virtual_cards|webhook|webhook_cards|webhook_whatsapp|whatsapp_bot_activation|alexa_covert)/?$ /$1.php [L]

# Dedicated Storefront Domain Routing
RewriteCond %{HTTP_HOST} ^(www\.)?payroute\.name$ [NC]
RewriteRule ^/?$ E-store/index.php [L,QSA]

# Reseller Storefront Routing (Catch-all for store slugs on payroute.name)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/setup [NC]
RewriteCond %{REQUEST_URI} !^/prices [NC]
RewriteCond %{REQUEST_URI} !^/withdrawal [NC]
RewriteCond %{REQUEST_URI} !^/withdrwal [NC]
RewriteCond %{REQUEST_URI} !^/store_control [NC]
RewriteCond %{REQUEST_URI} !^/store-control [NC]
RewriteCond %{REQUEST_URI} !^/front [NC]
RewriteCond %{REQUEST_URI} !^/admin [NC]
RewriteCond %{REQUEST_URI} !^/E-store [NC]
RewriteCond %{REQUEST_URI} !^/verify_paystack [NC]
RewriteCond %{REQUEST_URI} !^/webhook_paystack [NC]
RewriteCond %{REQUEST_URI} !^/verify_portal [NC]
RewriteCond %{REQUEST_URI} !^/ajax_ [NC]
RewriteCond %{REQUEST_URI} !^/shop [NC]
RewriteRule ^([a-zA-Z0-9_-]+)/?$ E-store/index.php?slug=$1 [L,QSA]

# Protect config, env, sensitive settings, and log files
<FilesMatch "^(config\.php|\.env|admin_settings\.json|.*\.log|database/.*)$">
    Require all denied
</FilesMatch>
